apiVersion: api.kagent.dev/v1alpha3
kind: Harness
metadata:
  name: kagent
  namespace: kagent
spec:
  kagent: {}
  workload:
    image: ${KAGENT_E2E_RUNTIME_IMAGE}
  ax:
    taskGroupRef:
      name: kagent-default
---
apiVersion: api.kagent.dev/v1alpha3
kind: Harness
metadata:
  name: codex-e2e
  namespace: kagent
spec:
  codex: {}
  workload:
    image: ${KAGENT_E2E_CODEX_IMAGE}
  ax:
    taskGroupRef:
      name: kagent-default
---
apiVersion: api.kagent.dev/v1alpha3
kind: Harness
metadata:
  name: byo-e2e
  namespace: kagent
spec:
  byo: {}
  workload:
    image: ${KAGENT_E2E_BYO_IMAGE}
    command: ["/app"]
  ax:
    taskGroupRef:
      name: kagent-default
---
apiVersion: api.kagent.dev/v1alpha3
kind: Harness
metadata:
  name: byo-adk-e2e
  namespace: kagent
spec:
  byo: {}
  workload:
    image: ${KAGENT_E2E_RUNTIME_IMAGE}
    command: ["/app"]
  env:
  - name: KAGENT_PORT
    value: "80"
  ax:
    taskGroupRef:
      name: kagent-default
---
apiVersion: api.kagent.dev/v1alpha3
kind: Harness
metadata:
  name: claude-e2e
  namespace: kagent
spec:
  claude: {}
  workload:
    image: ${KAGENT_E2E_CLAUDE_IMAGE}
  ax:
    taskGroupRef:
      name: kagent-default
---
apiVersion: api.kagent.dev/v1alpha3
kind: AgentTemplate
metadata:
  name: smoke
  namespace: kagent
  labels:
    kagent.dev/e2e-runtime: kagent
spec:
  description: Minimal Session lifecycle fixture
  modelConfig:
    name: default-model-config
  systemPrompt: Reply briefly.
---
apiVersion: api.kagent.dev/v1alpha3
kind: AgentTemplate
metadata:
  name: byo-smoke
  namespace: kagent
  labels:
    kagent.dev/e2e-runtime: byo
spec:
  description: Opaque BYO A2A fixture without managed configuration
---
apiVersion: api.kagent.dev/v1alpha3
kind: Agent
metadata:
  name: smoke
  namespace: kagent
spec:
  templateRef:
    name: smoke
  harnessRef:
    name: kagent
---
apiVersion: api.kagent.dev/v1alpha3
kind: Agent
metadata:
  name: byo-smoke
  namespace: kagent
spec:
  templateRef:
    name: byo-smoke
  harnessRef:
    name: byo-e2e
